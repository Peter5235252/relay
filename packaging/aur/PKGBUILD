# Maintainer: Cseman Peter <csemanpeter@pop-os.home>
pkgname=relay
pkgver=0.1.8
pkgrel=1
pkgdesc="Memory-safe Rust desktop agentic chat client unifying Gemini, Claude, GPT, Ollama and local models"
arch=('x86_64')
url="https://github.com/Peter5235252/relay"
license=('Apache-2.0')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libx11' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'mesa' 'vulkan-icd-loader' 'alsa-lib' 'glib2' 'gtk3' 'openssl')
makedepends=('rust' 'cargo' 'clang' 'cmake' 'pkgconf')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')
options=('!lto')

build() {
    cd "$srcdir/$pkgname"
    cargo build --release --locked -p relay-ui -p relay-cli
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 "target/release/relay" "$pkgdir/usr/bin/relay"
    install -Dm755 "target/release/relay-cli" "$pkgdir/usr/bin/relay-cli"
    install -Dm755 "target/release/relay-clear" "$pkgdir/usr/bin/relay-clear"

    install -Dm644 "packaging/io.github.csemanpeter.Relay.desktop" \
        "$pkgdir/usr/share/applications/io.github.csemanpeter.Relay.desktop"

    install -Dm644 "packaging/icons/hicolor/scalable/apps/io.github.csemanpeter.Relay.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.csemanpeter.Relay.svg"
    for size in 16 32 48 64 128 256 512; do
        install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/io.github.csemanpeter.Relay.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.github.csemanpeter.Relay.png"
    done

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}